rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if own(uid);
      allow create: if own(uid)
        && request.resource.data.keys().hasOnly([
          'username','displayName','photoUrl','createdAt','totalActivities',
          'currentStreak','longestStreak','xp','level','lastActivityDate',
          'completedCategories','unlockedAchievements'
        ])
        && request.resource.data.totalActivities == 0
        && request.resource.data.currentStreak == 0
        && request.resource.data.longestStreak == 0
        && request.resource.data.xp == 0
        && request.resource.data.level == 1
        && request.resource.data.unlockedAchievements.size() == 0
        && request.resource.data.completedCategories.size() == 0;
      allow update: if own(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'username','displayName','photoUrl','timezone','notificationPreferences'
        ]);
      allow delete: if false;

      match /dailyChallenges/{date} {
        allow read: if own(uid);
        // Assignment selection and completion state are trusted-backend only.
        allow create: if false;
        allow update: if false;
        allow delete: if false;
      }

      match /activities/{activityId} {
        allow read: if own(uid);
        allow write: if false;
      }

      match /activityDays/{date} {
        allow read: if own(uid);
        allow write: if false;
      }

      match /achievements/{achievementId} {
        allow read: if own(uid);
        allow write: if false;
      }
    }

    match /challenges/{challengeId} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
