rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if own(uid);
      allow create: if own(uid);
      allow update: if own(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username','displayName','photoUrl','createdAt','timezone','notificationPreferences']);
      allow delete: if false;

      match /dailyChallenges/{date} {
        allow read: if own(uid);
        allow create: if own(uid) && request.resource.data.keys().hasOnly(['challengeId','assignedAt','completed','completedAt']);
        allow update: if own(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completed','completedAt']);
        allow delete: if false;
      }
      match /activityDays/{date} {
        allow read: if own(uid);
        allow write: if false;
      }
      match /achievements/{achievementId} {
        allow read: if own(uid);
        allow write: if false;
      }
    }
    match /challenges/{challengeId} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
